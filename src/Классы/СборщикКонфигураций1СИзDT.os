Перем Лог;

Процедура ОписаниеКоманды(Команда) Экспорт

	Команда.Опция("v v8version", "8.3", "маска версии платформы 1С (8.3, 8.3.27 и т.п.)")
	       .ТСтрока()
	       .ВОкружении("V8VERSION");

	Команда.Опция("dt-path", "", "путь к файлу выгрузки информационной базы (DT)")
	       .ТСтрока()
	       .ВОкружении("YARD_DT_PATH");

	Команда.Опция("cf-output-path", "", "путь к выходному файлу конфигурации (CF); по умолчанию 1cv8.cf рядом с DT")
	       .ТСтрока()
	       .ВОкружении("YARD_CF_OUTPUT_PATH");

КонецПроцедуры

Процедура ВыполнитьКоманду(Знач Команда) Экспорт

	ПараметрыПриложения.УстановитьРежимОтладки(Команда.ЗначениеОпции("verbose"));

	ПутьКDT = Команда.ЗначениеОпции("dt-path");
	Если НЕ ЗначениеЗаполнено(ПутьКDT) Тогда
		ВызватьИсключение "Не задан обязательный параметр --dt-path.";
	КонецЕсли;

	ФайлDT = Новый Файл(ПутьКDT);
	Если НЕ ФайлDT.Существует() ИЛИ НЕ ФайлDT.ЭтоФайл() Тогда
		ВызватьИсключение СтрШаблон("Файл DT не найден: %1", ПутьКDT);
	КонецЕсли;

	ПутьКCF = Команда.ЗначениеОпции("cf-output-path");
	Если НЕ ЗначениеЗаполнено(ПутьКCF) Тогда
		ПутьКCF = ОбъединитьПути(ФайлDT.Путь, "1cv8.cf");
	КонецЕсли;

	Сборщик = Новый СборщикКонфигураций1С();
	Сборщик.УстановитьПараметрОбработкиДанных("ВерсияПлатформы", Команда.ЗначениеОпции("v8version"));
	Сборщик.ИзвлечьCFИзDT(ФайлDT.ПолноеИмя, ПутьКCF);

	Лог.Информация("[%1]: CF из файла DT %2 выгружен в %3.",
	               СокрЛП(ЭтотОбъект),
	               ФайлDT.ПолноеИмя,
	               ПутьКCF);

КонецПроцедуры

Процедура ПриСозданииОбъекта(Менеджер = Неопределено)

	Лог = ПараметрыПриложения.Лог();
	Лог.Информация("[%1]: Инициализирован обработчик", ТипЗнч(ЭтотОбъект));

КонецПроцедуры
