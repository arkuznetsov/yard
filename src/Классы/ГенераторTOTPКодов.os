Функция ПолучитьКодTOTP(Знач СекретBase32, Знач ШагВремени = 30, Знач КоличествоЦифр = 6) Экспорт
	
	БайтыКлюча = ДекодироватьBase32(СекретBase32);
	Если БайтыКлюча = Неопределено Тогда
		ВызватьИсключение "Некорректный ключ Base32!";
	КонецЕсли;
	
	БайтыСчетчика = ПолучитьБайтыСчетчика(ШагВремени);
	БайтыХеша     = ВычислитьHMAC_SHA1(БайтыКлюча, БайтыСчетчика);
	
	Возврат ПолучитьЗначениеУсечения(БайтыХеша, КоличествоЦифр);
	
КонецФункции

#Область ВычислениеHMAC

Функция ВычислитьHMAC_SHA1(Знач БайтыКлюча, Знач БайтыСообщения)
	
	РазмерБлока = 64; // 64 байта для блока SHA-1
	
	HexКлюч = ВРег(СтрЗаменить(ПолучитьHexСтрокуИзДвоичныхДанных(БайтыКлюча), " ", ""));
	ДлинаКлючаБайт = СтрДлина(HexКлюч) / 2;
	
	// Если ключ длиннее 64 байт - берем его SHA-1
	Если ДлинаКлючаБайт > РазмерБлока Тогда
		ХешКлюча = Новый ХешированиеДанных(ХешФункция.SHA1);
		ХешКлюча.Добавить(БайтыКлюча);
		HexКлюч = ВРег(СтрЗаменить(Строка(ХешКлюча.ХешСумма), " ", ""));
		ДлинаКлючаБайт = СтрДлина(HexКлюч) / 2;
	КонецЕсли;
	
	// Дополняем ключ нулями справа до 64 байт (128 hex-символов)
	Пока ДлинаКлючаБайт < РазмерБлока Цикл
		HexКлюч = HexКлюч + "00";
		ДлинаКлючаБайт = ДлинаКлючаБайт + 1;
	КонецЦикла;
	
	HexIpad = "";
	HexOpad = "";
	
	Для ИндексБайта = 0 По РазмерБлока - 1 Цикл
		БайтКлюча = HexВЧисло(Сред(HexКлюч, ИндексБайта * 2 + 1, 2));
		
		// БайтКлюча теперь сохраняет свое значение между вызовами
		HexIpad = HexIpad + БайтВHex(БайтXOR(БайтКлюча, 54)); // 0x36 = 54
		HexOpad = HexOpad + БайтВHex(БайтXOR(БайтКлюча, 92)); // 0x5C = 92
	КонецЦикла;
	
	// 1. Внутренний блок = (K XOR ipad) + Сообщение
	HexСообщения = ВРег(СтрЗаменить(ПолучитьHexСтрокуИзДвоичныхДанных(БайтыСообщения), " ", ""));
	HexВнутреннийБлок = HexIpad + HexСообщения;
	
	ХешВнутренний = Новый ХешированиеДанных(ХешФункция.SHA1);
	ХешВнутренний.Добавить(ПолучитьДвоичныеДанныеИзHexСтроки(HexВнутреннийБлок));
	HexВнутреннийХеш = ВРег(СтрЗаменить(Строка(ХешВнутренний.ХешСумма), " ", ""));
	
	// 2. Внешний блок = (K XOR opad) + ВнутреннийХеш
	HexВнешнийБлок = HexOpad + HexВнутреннийХеш;
	
	ХешВнешний = Новый ХешированиеДанных(ХешФункция.SHA1);
	ХешВнешний.Добавить(ПолучитьДвоичныеДанныеИзHexСтроки(HexВнешнийБлок));
	HexИтог = ВРег(СтрЗаменить(Строка(ХешВнешний.ХешСумма), " ", ""));
	
	Возврат ПолучитьДвоичныеДанныеИзHexСтроки(HexИтог);
	
КонецФункции

Функция БайтXOR(Знач Байт1, Знач Байт2)
	Результат = 0;
	Множитель = 1;
	Для Бит = 1 По 8 Цикл
		Бит1 = Байт1 % 2;
		Байт1 = Цел(Байт1 / 2);
		Бит2 = Байт2 % 2;
		Байт2 = Цел(Байт2 / 2);
		
		Если Бит1 <> Бит2 Тогда
			Результат = Результат + Множитель;
		КонецЕсли;
		Множитель = Множитель * 2;
	КонецЦикла;
	Возврат Результат;
КонецФункции

Функция БайтВHex(Знач Байт)
	Таблица = "0123456789ABCDEF";
	Старшая = Цел(Байт / 16);
	Младшая = Байт % 16;
	Возврат Сред(Таблица, Старшая + 1, 1) + Сред(Таблица, Младшая + 1, 1);
КонецФункции

Функция HexВЧисло(Знач Стр)
	Таблица = "0123456789ABCDEF";
	СтрВРег = ВРег(СокрЛП(Стр));
	Число = 0;
	Для Поз = 1 По СтрДлина(СтрВРег) Цикл
		Число = Число * 16 + (СтрНайти(Таблица, Сред(СтрВРег, Поз, 1)) - 1);
	КонецЦикла;
	Возврат Число;
КонецФункции

#КонецОбласти

#Область ВспомогательныеФункции

Функция ПолучитьБайтыСчетчика(ШагВремени)
	
	UnixTime = УниверсальноеВремя(ТекущаяДата()) - Дата(1970, 1, 1, 0, 0, 0);  // noqa: BSL097
	Счетчик  = Цел(UnixTime / ШагВремени);
	
	МассивБайт = Новый Массив(8);
	Для НомерБайта = 1 По 8 Цикл
		МассивБайт[8 - НомерБайта] = Счетчик % 256;
		Счетчик = Цел(Счетчик / 256);
	КонецЦикла;
	
	СтрHex = "";
	Для Каждого Байт Из МассивБайт Цикл
		СтрHex = СтрHex + БайтВHex(Байт);
	КонецЦикла;
	
	Возврат ПолучитьДвоичныеДанныеИзHexСтроки(СтрHex);
	
КонецФункции

// Побитовое декодирование Base32 через массив битов (без больших чисел)
// Параметры:
//   ВходнаяСтрока - Строка - Строка в кодировке Base32; допускаются пробелы, дефисы и символы заполнения "=".
// Возвращаемое значение:
//   Двоичные данные, полученные декодированием строки, либо Неопределено при недопустимом символе.
Функция ДекодироватьBase32(Знач ВходнаяСтрока)
	
	Алфавит = "ABCDEFGHIJKLMNOPQRSTUVWXYZ234567";
	ЧистаяСтрока = ВРег(СтрЗаменить(СтрЗаменить(ВходнаяСтрока, " ", ""), "-", ""));
	ЧистаяСтрока = СтрЗаменить(ЧистаяСтрока, "=", "");
	
	// Раскладываем все символы в плоский массив 0 и 1
	МассивБит = Новый Массив;
	Для Поз = 1 По СтрДлина(ЧистаяСтрока) Цикл
		Символ = Сред(ЧистаяСтрока, Поз, 1);
		Индекс = СтрНайти(Алфавит, Символ);
		Если Индекс = 0 Тогда
			Возврат Неопределено;
		КонецЕсли;
		
		Значение = Индекс - 1; // 5 бит (0..31)
		
		// Записываем 5 бит от старшего к младшему
		МассивБит.Добавить(Цел(Значение / 16) % 2);
		МассивБит.Добавить(Цел(Значение / 8) % 2);
		МассивБит.Добавить(Цел(Значение / 4) % 2);
		МассивБит.Добавить(Цел(Значение / 2) % 2);
		МассивБит.Добавить(Значение % 2);
	КонецЦикла;
	
	// Собираем полные байты (по 8 бит)
	КоличествоБайт = Цел(МассивБит.Количество() / 8);
	СтрHex = "";
	
	Для ИндексБайта = 0 По КоличествоБайт - 1 Цикл
		СмещениеБит = ИндексБайта * 8;
		ЗначениеБайта = 
			МассивБит[СмещениеБит]     * 128 +
			МассивБит[СмещениеБит + 1] * 64  +
			МассивБит[СмещениеБит + 2] * 32  +
			МассивБит[СмещениеБит + 3] * 16  +
			МассивБит[СмещениеБит + 4] * 8   +
			МассивБит[СмещениеБит + 5] * 4   +
			МассивБит[СмещениеБит + 6] * 2   +
			МассивБит[СмещениеБит + 7];
			
		СтрHex = СтрHex + БайтВHex(ЗначениеБайта);
	КонецЦикла;
	
	Возврат ПолучитьДвоичныеДанныеИзHexСтроки(СтрHex);
	
КонецФункции

Функция ПолучитьЗначениеУсечения(БайтыХеша, КоличествоЦифр)
	
	СтрHex = ВРег(ПолучитьHexСтрокуИзДвоичныхДанных(БайтыХеша));
	
	// Последний байт (байты 19 в 0-based = символы 39, 40)
	МладшийБайт = HexВЧисло(Сред(СтрHex, 39, 2));
	Смещение    = МладшийБайт % 16;
	
	HexБлок = Сред(СтрHex, Смещение * 2 + 1, 8);
	
	Байт0 = HexВЧисло(Сред(HexБлок, 1, 2)) % 128; // сброс старшего знакового бита
	Байт1 = HexВЧисло(Сред(HexБлок, 3, 2));
	Байт2 = HexВЧисло(Сред(HexБлок, 5, 2));
	Байт3 = HexВЧисло(Сред(HexБлок, 7, 2));
	
	ЧисловойКод = Байт0 * 16777216 + Байт1 * 65536 + Байт2 * 256 + Байт3;
	РезультатЧисло = ЧисловойКод % Pow(10, КоличествоЦифр);
	
	СтрокаКода = Формат(РезультатЧисло, "ЧГ=0");
	Пока СтрДлина(СтрокаКода) < КоличествоЦифр Цикл
		СтрокаКода = "0" + СтрокаКода;
	КонецЦикла;
	
	Возврат СтрокаКода;
	
КонецФункции

Процедура ТестЧистогоHMAC() Экспорт
	
	// Тест RFC 2202 (Test Case 2)
	// Key:  "Jefe" -> 4A656665
	// Data: "what do ya want for nothing?" -> 7768617420646F2079612077616E7420666F72206E6F7468696E673F
	КлючДД      = ПолучитьДвоичныеДанныеИзHexСтроки("4A656665");
	СообщениеДД = ПолучитьДвоичныеДанныеИзHexСтроки("7768617420646F2079612077616E7420666F72206E6F7468696E673F");
	
	ХешДД = ВычислитьHMAC_SHA1(КлючДД, СообщениеДД);
	ХешСтрока = НРег(ПолучитьHexСтрокуИзДвоичныхДанных(ХешДД));
	
	Сообщить("Вычисленный HMAC: " + ХешСтрока);
	Сообщить("Ожидаемый HMAC:  effcdf6ae5eb2fa2d27416d5f184df9c259a7c79");
	
	Если ХешСтрока = "effcdf6ae5eb2fa2d27416d5f184df9c259a7c79" Тогда
		Сообщить(">>> HMAC-SHA1 РАБОТАЕТ ИДЕАЛЬНО! <<<");
	Иначе
		Сообщить(">>> В HMAC-SHA1 ОШИБКА РАСЧЕТА! <<<");
	КонецЕсли;
	
КонецПроцедуры

Процедура ДиагностикаHMAC() Экспорт
	
	КлючДД      = ПолучитьДвоичныеДанныеИзHexСтроки("4A656665");
	СообщениеДД = ПолучитьДвоичныеДанныеИзHexСтроки("7768617420646F2079612077616E7420666F72206E6F7468696E673F");
	
	Хеш = Новый ХешированиеДанных(ХешФункция.SHA1);
	Хеш.Добавить(КлючДД);
	
	Сообщить("Как 1С выводит ХешСумма: [" + Строка(Хеш.ХешСумма) + "]");
	Сообщить("После очистки от пробелов: [" + СтрЗаменить(Строка(Хеш.ХешСумма), " ", "") + "]");
	
	// Запуск чистого теста
	ХешДД = ВычислитьHMAC_SHA1(КлючДД, СообщениеДД);
	ХешСтрока = НРег(СтрЗаменить(Строка(ХешДД), " ", ""));
	Если ПустаяСтрока(ХешСтрока) Тогда
		ХешСтрока = НРег(ПолучитьHexСтрокуИзДвоичныхДанных(ХешДД));
	КонецЕсли;
	
	Сообщить("Результат HMAC: " + ХешСтрока);
	Сообщить("Ожидается:      effcdf6ae5eb2fa2d27416d5f184df9c259a7c79");
	
КонецПроцедуры
#КонецОбласти           